{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dezirclip.local/protocol/v1/quick.schema.json",
  "$defs": {
    "QuickTicket": {
      "type": "object",
      "properties": {
        "token": {
          "type": "string",
          "minLength": 36,
          "maxLength": 36
        },
        "state": {
          "$ref": "https://dezirclip.local/protocol/v1/events.schema.json#/$defs/RuntimeState"
        }
      },
      "required": [
        "token",
        "state"
      ],
      "additionalProperties": false
    },
    "QuickDismissParams": {
      "type": "object",
      "properties": {
        "service_instance_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        },
        "expected_epoch": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991,
          "x-rust-type": "u64"
        },
        "token": {
          "type": "string",
          "minLength": 36,
          "maxLength": 36
        },
        "restore": {
          "type": "boolean"
        }
      },
      "required": [
        "service_instance_id",
        "expected_epoch",
        "token",
        "restore"
      ],
      "additionalProperties": false
    },
    "QuickPasteParams": {
      "type": "object",
      "properties": {
        "service_instance_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        },
        "expected_epoch": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991,
          "x-rust-type": "u64"
        },
        "token": {
          "type": "string",
          "minLength": 36,
          "maxLength": 36
        },
        "id": {
          "type": "integer",
          "minimum": -9007199254740991,
          "maximum": 9007199254740991,
          "x-rust-type": "i64",
          "not": {
            "const": 0
          }
        },
        "expected_history_revision": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991,
          "x-rust-type": "u64"
        }
      },
      "required": [
        "service_instance_id",
        "expected_epoch",
        "token",
        "id",
        "expected_history_revision"
      ],
      "additionalProperties": false
    },
    "QuickPreferences": {
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "hotkey": {
          "type": "string",
          "maxLength": 256
        }
      },
      "required": [
        "enabled",
        "hotkey"
      ],
      "additionalProperties": false
    }
  }
}
