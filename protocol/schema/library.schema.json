{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dezirclip.local/protocol/v1/library.schema.json",
  "$defs": {
    "LibraryStateParams": {
      "type": "object",
      "properties": {
        "service_instance_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        },
        "expected_epoch": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991,
          "x-rust-type": "u64"
        }
      },
      "required": [
        "service_instance_id",
        "expected_epoch"
      ],
      "additionalProperties": false
    },
    "LibraryTagParams": {
      "type": "object",
      "properties": {
        "service_instance_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        },
        "expected_epoch": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991,
          "x-rust-type": "u64"
        },
        "name": {
          "type": "string",
          "maxLength": 80,
          "minLength": 1
        }
      },
      "required": [
        "service_instance_id",
        "expected_epoch",
        "name"
      ],
      "additionalProperties": false
    },
    "LibraryRenameParams": {
      "type": "object",
      "properties": {
        "service_instance_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        },
        "expected_epoch": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991,
          "x-rust-type": "u64"
        },
        "name": {
          "type": "string",
          "maxLength": 80,
          "minLength": 1
        },
        "new_name": {
          "type": "string",
          "maxLength": 80,
          "minLength": 1
        }
      },
      "required": [
        "service_instance_id",
        "expected_epoch",
        "name",
        "new_name"
      ],
      "additionalProperties": false
    },
    "LibraryPinOrder": {
      "type": "object",
      "properties": {
        "id": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991,
          "x-rust-type": "i64"
        },
        "order": {
          "type": "integer",
          "minimum": -9007199254740991,
          "maximum": 9007199254740991,
          "x-rust-type": "i64"
        }
      },
      "required": [
        "id",
        "order"
      ],
      "additionalProperties": false
    },
    "LibraryOrderParams": {
      "type": "object",
      "properties": {
        "service_instance_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        },
        "expected_epoch": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991,
          "x-rust-type": "u64"
        },
        "orders": {
          "type": "array",
          "items": {
            "$ref": "https://dezirclip.local/protocol/v1/library.schema.json#/$defs/LibraryPinOrder"
          },
          "maxItems": 32768
        }
      },
      "required": [
        "service_instance_id",
        "expected_epoch",
        "orders"
      ],
      "additionalProperties": false
    },
    "LibraryColorParams": {
      "type": "object",
      "properties": {
        "service_instance_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        },
        "expected_epoch": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991,
          "x-rust-type": "u64"
        },
        "name": {
          "type": "string",
          "maxLength": 80,
          "minLength": 1
        },
        "color": {
          "type": "string",
          "maxLength": 128
        }
      },
      "required": [
        "service_instance_id",
        "expected_epoch",
        "name"
      ],
      "additionalProperties": false
    },
    "LibraryTagBatchParams": {
      "type": "object",
      "properties": {
        "service_instance_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        },
        "expected_epoch": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991,
          "x-rust-type": "u64"
        },
        "name": {
          "type": "string",
          "maxLength": 80,
          "minLength": 1
        },
        "scope": {
          "type": "string",
          "enum": [
            "selected",
            "all"
          ]
        },
        "ids": {
          "type": "array",
          "maxItems": 10000,
          "items": {
            "type": "integer",
            "minimum": 1,
            "maximum": 9007199254740991,
            "x-rust-type": "i64"
          }
        },
        "query": {
          "type": "string",
          "maxLength": 256
        }
      },
      "required": [
        "service_instance_id",
        "expected_epoch",
        "name",
        "scope",
        "ids"
      ],
      "additionalProperties": false
    },
    "LibraryDeleted": {
      "type": "object",
      "properties": {
        "deleted_count": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991,
          "x-rust-type": "u64"
        },
        "cleanup_failed": {
          "type": "boolean"
        }
      },
      "required": [
        "deleted_count",
        "cleanup_failed"
      ],
      "additionalProperties": false
    },
    "LibraryCount": {
      "type": "object",
      "properties": {
        "count": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991,
          "x-rust-type": "u64"
        }
      },
      "required": [
        "count"
      ],
      "additionalProperties": false
    },
    "LibraryCounts": {
      "type": "object",
      "properties": {
        "values": {
          "type": "object",
          "additionalProperties": {
            "type": "integer"
          }
        }
      },
      "required": [
        "values"
      ],
      "additionalProperties": false
    },
    "LibraryColors": {
      "type": "object",
      "properties": {
        "values": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        }
      },
      "required": [
        "values"
      ],
      "additionalProperties": false
    }
  }
}
