{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dezirclip.local/protocol/v1/files.schema.json",
  "$defs": {
    "FileDropParams": {
      "type": "object", "additionalProperties": false,
      "properties": {
        "service_instance_id": { "type": "string", "minLength": 1, "maxLength": 64 },
        "expected_epoch": { "type": "integer", "minimum": 0, "maximum": 9007199254740991, "x-rust-type": "u64" },
        "paths": { "type": "array", "minItems": 1, "maxItems": 256, "items": { "type": "string", "minLength": 1, "maxLength": 32768 } }
      }, "required": ["service_instance_id", "expected_epoch", "paths"]
    },
    "FileDragParams": {
      "type": "object", "additionalProperties": false,
      "properties": {
        "service_instance_id": { "type": "string", "minLength": 1, "maxLength": 64 },
        "expected_epoch": { "type": "integer", "minimum": 0, "maximum": 9007199254740991, "x-rust-type": "u64" },
        "id": { "type": "integer", "minimum": -9007199254740991, "maximum": 9007199254740991, "x-rust-type": "i64" },
        "reveal": { "type": "boolean" }
      }, "required": ["service_instance_id", "expected_epoch", "id", "reveal"]
    },
    "FileDragResult": {
      "type": "object", "additionalProperties": false,
      "properties": {
        "paths": { "type": "array", "minItems": 1, "maxItems": 256, "items": { "type": "string", "minLength": 1, "maxLength": 32768 } }
      }, "required": ["paths"]
    }
  }
}
