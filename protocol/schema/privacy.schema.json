{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dezirclip.local/protocol/v1/privacy.schema.json",
  "$defs": {
    "PrivacyState": {
      "type": "object",
      "properties": {
        "active": {
          "type": "boolean"
        },
        "privacy_epoch": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991,
          "x-rust-type": "u64"
        },
        "expires_at_ms": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0,
          "maximum": 9007199254740991,
          "x-rust-type": "Option<i64>"
        }
      },
      "required": [
        "active",
        "privacy_epoch",
        "expires_at_ms"
      ],
      "additionalProperties": true
    },
    "PrivacySetParams": {
      "type": "object",
      "properties": {
        "active": {
          "type": "boolean"
        },
        "duration_ms": {
          "type": "integer",
          "minimum": 1,
          "maximum": 86400000,
          "x-rust-type": "u64"
        }
      },
      "required": [
        "active"
      ],
      "additionalProperties": true
    }
  }
}
