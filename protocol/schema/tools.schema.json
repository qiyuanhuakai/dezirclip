{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dezirclip.local/protocol/v1/tools.schema.json",
  "$defs": {
    "DesktopFont": {
      "type": "object",
      "properties": { "family": { "type": "string" }, "is_mono": { "type": "boolean" }, "path": { "type": "string" } },
      "required": ["family", "is_mono", "path"], "additionalProperties": false
    },
    "DesktopFontList": {
      "type": "object",
      "properties": { "fonts": { "type": "array", "items": { "$ref": "https://dezirclip.local/protocol/v1/tools.schema.json#/$defs/DesktopFont" } } },
      "required": ["fonts"], "additionalProperties": false
    },
    "ToolCatalogParams": {
      "type": "object",
      "properties": {},
      "required": [],
      "additionalProperties": false
    },
    "ToolClassifyParams": {
      "type": "object",
      "properties": {
        "text": {
          "type": "string",
          "maxLength": 250000
        }
      },
      "required": [
        "text"
      ],
      "additionalProperties": false
    },
    "ToolTransformParams": {
      "type": "object",
      "properties": {
        "text": {
          "type": "string",
          "maxLength": 250000
        },
        "kind": {
          "type": "string",
          "maxLength": 64
        }
      },
      "required": [
        "text",
        "kind"
      ],
      "additionalProperties": false
    },
    "ToolQrParams": {
      "type": "object",
      "properties": {
        "content": {
          "type": "string",
          "maxLength": 8192
        },
        "format": {
          "type": "string",
          "enum": [
            "png",
            "svg"
          ]
        },
        "size_px": {
          "type": "integer",
          "minimum": 0,
          "maximum": 4294967295,
          "x-rust-type": "u32"
        }
      },
      "required": [
        "content",
        "format"
      ],
      "additionalProperties": false
    },
    "ToolTransformKind": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "maxLength": 64
        },
        "label_zh": {
          "type": "string",
          "maxLength": 80
        },
        "label_en": {
          "type": "string",
          "maxLength": 80
        }
      },
      "required": [
        "id",
        "label_zh",
        "label_en"
      ],
      "additionalProperties": false
    },
    "ToolCatalog": {
      "type": "object",
      "properties": {
        "content_kinds": {
          "type": "array",
          "maxItems": 64,
          "items": {
            "type": "string",
            "maxLength": 64
          }
        },
        "transforms": {
          "type": "array",
          "maxItems": 128,
          "items": {
            "$ref": "https://dezirclip.local/protocol/v1/tools.schema.json#/$defs/ToolTransformKind"
          }
        }
      },
      "required": [
        "content_kinds",
        "transforms"
      ],
      "additionalProperties": false
    },
    "ToolClassification": {
      "type": "object",
      "properties": {
        "kinds": {
          "type": "array",
          "maxItems": 64,
          "items": {
            "type": "string",
            "maxLength": 64
          }
        }
      },
      "required": [
        "kinds"
      ],
      "additionalProperties": false
    },
    "ToolText": {
      "type": "object",
      "properties": {
        "text": {
          "type": "string",
          "maxLength": 1048576
        }
      },
      "required": [
        "text"
      ],
      "additionalProperties": false
    }
  }
}
