{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dezirclip.local/protocol/v1/theme.schema.json",
  "$defs": {
    "ThemeIdParams": {
      "type": "object",
      "properties": {
        "service_instance_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        },
        "expected_epoch": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991,
          "x-rust-type": "u64"
        },
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 48,
          "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
        }
      },
      "required": [
        "service_instance_id",
        "expected_epoch",
        "id"
      ],
      "additionalProperties": false
    },
    "ThemeImportParams": {
      "type": "object",
      "properties": {
        "service_instance_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        },
        "expected_epoch": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991,
          "x-rust-type": "u64"
        },
        "path": {
          "type": "string",
          "minLength": 1,
          "maxLength": 32768
        }
      },
      "required": [
        "service_instance_id",
        "expected_epoch",
        "path"
      ],
      "additionalProperties": false
    },
    "ThemeExportParams": {
      "type": "object",
      "properties": {
        "service_instance_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        },
        "expected_epoch": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991,
          "x-rust-type": "u64"
        },
        "path": {
          "type": "string",
          "minLength": 1,
          "maxLength": 32768
        },
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 48,
          "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
        }
      },
      "required": [
        "service_instance_id",
        "expected_epoch",
        "path",
        "id"
      ],
      "additionalProperties": false
    },
    "ThemeIndex": {
      "type": "object",
      "properties": {
        "ids": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 48,
            "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
          },
          "maxItems": 32
        }
      },
      "required": [
        "ids"
      ],
      "additionalProperties": false
    },
    "ThemeRemoved": {
      "type": "object",
      "properties": {
        "active_reset": {
          "type": "boolean"
        }
      },
      "required": [
        "active_reset"
      ],
      "additionalProperties": false
    },
    "DesktopThemePackage": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 48,
          "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
        },
        "version": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1,
          "x-rust-type": "u32"
        },
        "format": {
          "type": "string",
          "enum": [
            "dezirclip-theme"
          ]
        },
        "base": {
          "type": "string",
          "maxLength": 48
        },
        "name": {
          "type": "string",
          "maxLength": 80
        },
        "author": {
          "type": "string",
          "maxLength": 80
        },
        "description": {
          "type": "string",
          "maxLength": 240
        },
        "css": {
          "type": "string",
          "maxLength": 262144
        }
      },
      "required": [
        "id",
        "version",
        "format",
        "base",
        "name",
        "css"
      ],
      "additionalProperties": false
    }
  }
}
