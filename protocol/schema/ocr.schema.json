{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dezirclip.local/protocol/v1/ocr.schema.json",
  "$defs": {
    "ManualOcrParams": {
      "type": "object",
      "properties": {
        "service_instance_id": {
          "type": "string",
          "maxLength": 64
        },
        "expected_epoch": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991,
          "x-rust-type": "u64"
        },
        "id": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991,
          "x-rust-type": "i64"
        },
        "reveal": {
          "type": "boolean"
        }
      },
      "required": [
        "service_instance_id",
        "expected_epoch",
        "id",
        "reveal"
      ],
      "additionalProperties": false
    },
    "ManualOcrText": {
      "type": "object",
      "properties": {
        "status": {
          "type": "string",
          "maxLength": 64
        },
        "text": {
          "type": "string",
          "maxLength": 33554432
        }
      },
      "required": [
        "status"
      ],
      "additionalProperties": false
    },
    "OcrEngineInfo": {
      "type": "object",
      "properties": {
        "available": {
          "type": "boolean"
        },
        "engine_name": {
          "type": "string",
          "maxLength": 64
        }
      },
      "required": [
        "available",
        "engine_name"
      ],
      "additionalProperties": false
    }
  }
}
