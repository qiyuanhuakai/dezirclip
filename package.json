{
  "name": "dezirclip",
  "private": true,
  "version": "0.2.0-alpha.3",
  "packageManager": "pnpm@11.0.9",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "test:e2e": "playwright test",
    "test:unit": "vitest run",
    "test:unit:watch": "vitest",
    "build": "tsc && vite build",
    "i18n:check": "node scripts/i18n-check.mjs",
    "preview": "vite preview",
    "tauri:prepare-sidecars": "node scripts/prepare-tauri-sidecars.mjs",
    "release:set-version": "node scripts/set-release-version.mjs",
    "flatpak:prepare": "node scripts/prepare-flatpak-root.mjs",
    "flatpak:build": "flatpak-builder --user --force-clean --repo=flatpak/repo flatpak/build flatpak/io.github.qiyuanhuakai.dezirclip.yml",
    "flatpak:bundle": "flatpak build-bundle flatpak/repo DezirClip.flatpak io.github.qiyuanhuakai.dezirclip",
    "tauri": "tauri",
    "tauri:dev": "tauri dev",
    "tauri:dev:safe": "DEZIRCLIP_DISABLE_LINUX_SERVICES=window_tracker,edge_docking,mouse_hotkey tauri dev",
    "tauri:build": "tauri build",
    "tauri:bundle:rpm": "node scripts/bundle-rpm.mjs",
    "build:portable": "tauri build --no-bundle --features portable && pnpm run tauri:prepare-sidecars --portable --release --phase portable && powershell -NoProfile -ExecutionPolicy Bypass -File scripts/package-portable.ps1"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.12.4",
    "@tauri-apps/plugin-dialog": "^2.7.1",
    "@tauri-apps/plugin-opener": "^2",
    "css-tree": "^3.2.1",
    "framer-motion": "^12.25.0",
    "fuse.js": "^7.4.2",
    "lucide-react": "^0.562.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-select": "^5.10.2",
    "react-virtuoso": "^4.18.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.40.0",
    "@tauri-apps/cli": "2.12.3",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/css-tree": "^3.2.0",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@types/react-select": "^5.0.0",
    "@vitejs/plugin-react": "^4.6.0",
    "jsdom": "^29.1.1",
    "playwright": "^1.40.0",
    "typescript": "~5.8.3",
    "vite": "^7.0.4",
    "vitest": "^4.1.9"
  },
  "overrides": {
    "react": "$react",
    "react-dom": "$react-dom"
  }
}
