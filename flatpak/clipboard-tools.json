{
  "name": "clipboard-tools",
  "buildsystem": "simple",
  "build-commands": [],
  "modules": [
    {
      "name": "leptonica",
      "buildsystem": "cmake-ninja",
      "builddir": true,
      "post-install": ["install -Dm644 ../leptonica-license.txt /app/share/licenses/dezirclip/leptonica.txt"],
      "config-opts": [
        "-DCMAKE_BUILD_TYPE=Release",
        "-DCMAKE_INSTALL_LIBDIR=lib",
        "-DBUILD_SHARED_LIBS=ON",
        "-DBUILD_PROG=OFF",
        "-DENABLE_GIF=OFF",
        "-DENABLE_WEBP=OFF",
        "-DENABLE_OPENJPEG=OFF"
      ],
      "cleanup": ["/include", "/lib/pkgconfig", "/lib/cmake", "*.a"],
      "sources": [
        {
          "type": "archive",
          "url": "https://github.com/DanBloomberg/leptonica/releases/download/1.87.0/leptonica-1.87.0.tar.gz",
          "sha256": "c73363397f96eb1295602bf44d708a994ad42046c791bf03ea0505d829bdb6a7"
        }
      ]
    },
    {
      "name": "tesseract",
      "buildsystem": "cmake-ninja",
      "builddir": true,
      "post-install": ["install -Dm644 ../LICENSE /app/share/licenses/dezirclip/tesseract.txt"],
      "config-opts": [
        "-DCMAKE_BUILD_TYPE=Release",
        "-DCMAKE_INSTALL_LIBDIR=lib",
        "-DTESSDATA_PREFIX=/app/share",
        "-DBUILD_SHARED_LIBS=ON",
        "-DBUILD_TRAINING_TOOLS=OFF",
        "-DBUILD_TESTS=OFF",
        "-DGRAPHICS_DISABLED=ON",
        "-DDISABLED_LEGACY_ENGINE=ON",
        "-DDISABLE_CURL=ON",
        "-DDISABLE_ARCHIVE=ON",
        "-DENABLE_NATIVE=OFF"
      ],
      "cleanup": ["/include", "/lib/pkgconfig", "/lib/cmake", "/share/man", "*.a"],
      "sources": [
        {
          "type": "archive",
          "url": "https://github.com/tesseract-ocr/tesseract/archive/refs/tags/5.5.3.tar.gz",
          "sha256": "9218e62793116d42a9f6d14cd9348518b27f382096eea3d0f2d1a24616bb5884"
        }
      ]
    },
    {
      "name": "tessdata-fast",
      "buildsystem": "simple",
      "build-commands": [
        "install -Dm644 eng.traineddata /app/share/tessdata/eng.traineddata",
        "install -Dm644 chi_sim.traineddata /app/share/tessdata/chi_sim.traineddata",
        "install -Dm644 osd.traineddata /app/share/tessdata/osd.traineddata",
        "install -Dm644 tessdata-LICENSE /app/share/licenses/dezirclip/tessdata-fast.txt"
      ],
      "sources": [
        {
          "type": "file",
          "url": "https://raw.githubusercontent.com/tesseract-ocr/tessdata_fast/65727574dfcd264acbb0c3e07860e4e9e9b22185/eng.traineddata",
          "sha256": "7d4322bd2a7749724879683fc3912cb542f19906c83bcc1a52132556427170b2"
        },
        {
          "type": "file",
          "url": "https://raw.githubusercontent.com/tesseract-ocr/tessdata_fast/65727574dfcd264acbb0c3e07860e4e9e9b22185/chi_sim.traineddata",
          "sha256": "a5fcb6f0db1e1d6d8522f39db4e848f05984669172e584e8d76b6b3141e1f730"
        },
        {
          "type": "file",
          "url": "https://raw.githubusercontent.com/tesseract-ocr/tessdata_fast/65727574dfcd264acbb0c3e07860e4e9e9b22185/osd.traineddata",
          "sha256": "9cf5d576fcc47564f11265841e5ca839001e7e6f38ff7f7aacf46d15a96b00ff"
        },
        {
          "type": "file",
          "url": "https://raw.githubusercontent.com/tesseract-ocr/tessdata_fast/65727574dfcd264acbb0c3e07860e4e9e9b22185/LICENSE",
          "dest-filename": "tessdata-LICENSE",
          "sha256": "cfc7749b96f63bd31c3c42b5c471bf756814053e847c10f3eb003417bc523d30"
        }
      ]
    },
    {
      "name": "xdotool",
      "buildsystem": "simple",
      "build-commands": [
        "make -j${FLATPAK_BUILDER_N_JOBS} PREFIX=/app xdotool.static",
        "make PREFIX=/app install-static",
        "install -Dm644 COPYRIGHT /app/share/licenses/dezirclip/xdotool.txt"
      ],
      "sources": [
        {
          "type": "archive",
          "url": "https://github.com/jordansissel/xdotool/archive/refs/tags/v4.20260303.1.tar.gz",
          "sha256": "c1f971a384da588eb99ca0755fc4300316d49c1e612537e3f1de52215e104fa3"
        }
      ]
    }
  ]
}
